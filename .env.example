# ── Core configuration ──────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
STAGING_BUCKET=your-project-agent-staging
POLICY_BUCKET=your-project-policies
POLICY_PREFIX=policies/
DISPLAY_NAME=policy-weather-agent
AGENT_MODEL=gemini-2.5-flash

# ── Gemini Enterprise (optional) ────────────────────────────────────────────
GEMINI_ENTERPRISE_APP_ID=
GEMINI_ENTERPRISE_LOCATION=global

# ── External API (OpenWeatherMap) ───────────────────────────────────────────
# Get a free API key at https://openweathermap.org/api
# This key is stored in Agent Identity Auth Manager — NOT in agent code.
EXTERNAL_API_URL=https://api.openweathermap.org/data/2.5/weather

# ── Auth Manager ─────────────────────────────────────────────────────────────
# Auth Provider resource name, created by:
#   gcloud agent-identity auth-providers create my-apikey-provider \
#     --location=us-central1 --api-key="YOUR_API_KEY"
# Format: projects/PROJECT_ID/locations/LOCATION/authProviders/PROVIDER_NAME
AUTH_PROVIDER_NAME=
